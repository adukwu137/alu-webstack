#!/usr/bin/env bash
# Displays the record type and destination of the subdomains of a domain
get_info() {
	local sub="$1"
	local domain="$2"
	dig "$sub.$domain" | grep -A1 'ANSWER SECTION:' | tail -n 1 | awk -v s="$sub" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ -n "$2" ]; then
	get_info "$2" "$1"
else
	for sub in www lb-01 web-01 web-02; do
		get_info "$sub" "$1"
	done
fi
