global
	log /dev/log local0
	log /dev/log local1 notice
	chroot /var/lib/haproxy
	stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
	stats timeout 30s
	user haproxy
	group haproxy
	daemon
	ssl-default-bind-options no-sslv3

defaults
	log global
	mode http
	option httplog
	option dontlognull
	timeout connect 5000
	timeout client 50000
	timeout server 50000

frontend http_front
	bind *:80
	bind *:443 ssl crt /etc/haproxy/certs/www.adukwu137.tech.pem
	mode http
	http-request set-header X-Forwarded-Proto https if { ssl_fc }
	redirect scheme https code 301 if !{ ssl_fc }
	default_backend http_back

backend http_back
	mode http
	balance roundrobin
	server 7232-web-01 18.171.204.227:80 check
	server 7232-web-02 18.171.160.168:80 check
